    given-names: Andrew
    orcid: "https://orcid.org/0009-0005-5476-1213"
repository-code: "https://github.com/AndrewAvery7/claude-markitdown-hook"
license: MIT
version: 1.1.1
date-released: "2026-08-30"
keywords:
