# Conversion cache (machine-local, regenerated on demand)
markitdown-cache/

# Backups the installer creates
*.bak-*

# Promo video intermediates and output. All regenerable from tools/, and the
# finished MP4 ships as a release asset rather than bloating every clone.
assets/*.mp4
assets/*.gif

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Test fixtures are generated at run time, never committed
tests/_generated/

# Local knowledge-graph artifacts (machine-local, regenerated by graphify)
graphify-out/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Graphify knowledge-graph output (personal tooling; contains local paths -
# must never ship in a public repo)
graphify-out/
